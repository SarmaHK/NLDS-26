generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id                   String   @id @default(uuid()) @db.Uuid
  fullName             String?
  preferredName        String?
  personalEmail        String?
  phone                String
  profilePicture       String
  gender               String?
  dateOfBirth          String?
  nationalIdOrPassport String?  @unique
  aiesecEmail          String?  @unique
  aiesecEmailVerifiedAt DateTime?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  registrations        Registration[]
  sessions             ParticipantSession[]
}

model Entity {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  code             String?  @unique
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  initiativeGroups InitiativeGroup[]
  registrations    Registration[]
}

model InitiativeGroup {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  entityId         String   @db.Uuid
  entity           Entity   @relation(fields: [entityId], references: [id])
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  registrations    Registration[]

  @@unique([name, entityId])
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  CANCELLED
}

model Registration {
  id                    String             @id @default(uuid()) @db.Uuid
  referenceCode         String             @unique
  participantId         String             @db.Uuid
  participant           Participant        @relation(fields: [participantId], references: [id])
  entityId              String             @db.Uuid
  entity                Entity             @relation(fields: [entityId], references: [id])
  initiativeGroupId     String?            @db.Uuid
  initiativeGroup       InitiativeGroup?   @relation(fields: [initiativeGroupId], references: [id])
  customInitiativeGroup String?
  participantType       String            @default("OLDBIE")
  currentPosition       String

  foodPreference        String
  medicalConditions     String?
  guardianName          String
  guardianContact       String

  missionGoal           String
  additionalInformation String?
  readinessLevel        String

  status                RegistrationStatus @default(DRAFT)
  
  submittedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  documents             Document[]
  reviews               RegistrationReview[]

  @@index([status])
  @@index([participantId])
  @@index([entityId])
  
  externalSyncs  ExternalSync[]
}

model ExternalSync {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @db.Uuid
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  
  provider       String       
  eventType      String       
  status         String       
  
  attempts       Int          @default(0)
  lastAttemptAt  DateTime?
  syncedAt       DateTime?
  errorMessage   String?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([registrationId])
  @@index([status])
  @@index([provider])
}

enum DocumentType {
  CV
  MEDICAL_CERT
  OTHER
}

model Document {
  id              String       @id @default(uuid()) @db.Uuid
  registrationId  String       @db.Uuid
  registration    Registration @relation(fields: [registrationId], references: [id])
  type            DocumentType @default(CV)
  urlReference    String
  consentGiven    Boolean?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  OC_ADMIN
}

model Admin {
  id                   String               @id @default(uuid()) @db.Uuid
  email                String               @unique
  role                 AdminRole            @default(OC_ADMIN)
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  lastLoginAt          DateTime?

  permissions          AdminPermission[]
  invitationsSent      AdminInvitation[]
  reviews              RegistrationReview[] 
  requestsReviewed     AdminAccessRequest[]
  sessions             AdminSession[] 

  @@index([email])
}

enum Permission {
  VIEW_REGISTRATION
  REVIEW_REGISTRATION
  ACCEPT_REGISTRATION
  REJECT_REGISTRATION
  DOCUMENT_VIEW
  VIEW_SENSITIVE_PROFILE
  MANAGE_ADMINS
  VIEW_AUDIT_LOGS
}

model AdminPermission {
  id         String     @id @default(uuid()) @db.Uuid
  adminId    String     @db.Uuid
  admin      Admin      @relation(fields: [adminId], references: [id])
  permission Permission

  @@index([adminId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model AdminInvitation {
  id                  String           @id @default(uuid()) @db.Uuid
  email               String           @unique
  token               String           @unique
  status              InvitationStatus @default(PENDING)
  assignedPermissions String           
  expiresAt           DateTime
  createdBy           String           @db.Uuid
  creator             Admin            @relation(fields: [createdBy], references: [id])
  acceptedAt          DateTime?
  createdAt           DateTime         @default(now())
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdminAccessRequest {
  id          String        @id @default(uuid()) @db.Uuid
  email       String
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  reviewedBy  String?       @db.Uuid
  reviewer    Admin?        @relation(fields: [reviewedBy], references: [id])
  reviewedAt  DateTime?
}

enum ReviewDecision {
  ACCEPTED
  REJECTED
}

model RegistrationReview {
  id              String         @id @default(uuid()) @db.Uuid
  registrationId  String         @db.Uuid
  registration    Registration   @relation(fields: [registrationId], references: [id])
  reviewerId      String         @db.Uuid
  reviewer        Admin          @relation(fields: [reviewerId], references: [id])
  decision        ReviewDecision
  internalReason  String         
  createdAt       DateTime       @default(now())

  @@index([registrationId])
  @@index([reviewerId])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorId     String?   @db.Uuid
  actorType   String    
  action      String
  targetId    String?   @db.Uuid
  targetType  String
  metadata    String?   
  createdAt   DateTime  @default(now())

  @@index([targetId])
  @@index([createdAt])
}

model OTPChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  otpHash     String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model ParticipantSession {
  id            String      @id @default(uuid()) @db.Uuid
  participantId String      @db.Uuid
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([participantId])
  @@index([expiresAt])
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminId     String    @db.Uuid
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminId])
  @@index([expiresAt])
}
